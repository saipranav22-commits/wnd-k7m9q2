{
  "functions": {
    "api/index.py": {
      "excludeFiles": "{frontend/**,docs/**,tests/**,scripts/**,.venv/**,*.md,*.json,*.yml,*.whl,*.lock}"
    }
  },
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "api/index.py"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "dest": "frontend/dist/$1"
    }
  ]
}
